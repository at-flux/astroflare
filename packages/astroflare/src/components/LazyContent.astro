---
/**
 * Fetch-on-demand content holder. Renders nothing but a loading state until it
 * is asked to fetch `src` (an HTML fragment / Astro partial route), then swaps
 * the response into place. Heavy modal bodies (long policies, big forms) can
 * live behind this so they stop shipping inline on every page and only load the
 * first time their modal opens.
 *
 * A preset over {@link Suspense.astro}: same gate → readiness → swap machine,
 * fixed to `src` readiness and defaulting to the dialog gate.
 *
 * Trigger (`when`):
 *  - `dialog-open` (default): fetch the first time the nearest ancestor
 *    `<dialog>` opens (native `<dialog>` toggles its `open` attribute). With no
 *    dialog ancestor it falls back to fetching immediately. Re-opening a dialog
 *    whose fetch failed retries it.
 *  - `visible`: fetch when the element first scrolls into view.
 *  - `immediate`: fetch as soon as it connects.
 *
 * Loading and error UI are overridable via the `loading` / `error` slots; the
 * defaults are theme-agnostic (they inherit `currentColor`).
 *
 * ### How it maps onto Suspense
 * | LazyContent          | Suspense                                          |
 * | -------------------- | ------------------------------------------------- |
 * | `src`                | `src`                                             |
 * | `when="dialog-open"` | `when="dialog-open"`                              |
 * | `when="immediate"`   | `when="eager"`                                    |
 * | `when="visible"`     | `when="visible"`                                  |
 * | `class`              | `class`                                           |
 * | `loading` slot       | `placeholder` slot                                |
 * | `error` slot         | `error` slot                                      |
 * | *(implicit)*         | `minHeight="12rem"` — holds the box open while pending |
 *
 * Anything Suspense adds and this does not expose — `timeout`, `skeleton`,
 * `graceDelay`, `minDisplay`, `aspectRatio` — is available by using `Suspense`
 * directly.
 *
 * The rendered host element is `<af-suspense>` (it was `<af-lazy-content>`
 * before the unification).
 */
import Suspense from './Suspense.astro';

interface Props {
  /** Fragment / partial URL to fetch. */
  src: string;
  /** When to fetch. Default `dialog-open`. */
  when?: 'dialog-open' | 'visible' | 'immediate';
  /** Classes on the host element. */
  class?: string;
}

const { src, when = 'dialog-open', class: className } = Astro.props;

const gate = when === 'immediate' ? 'eager' : when;
---

<Suspense src={src} when={gate} class={className} minHeight='12rem'>
  <div slot='placeholder'>
    <slot name='loading'>
      <div class='af-lazy-spinner-wrap'>
        <span class='af-lazy-spinner' aria-hidden='true'></span>
        <p class='af-lazy-loading-text'>Loading…</p>
      </div>
    </slot>
  </div>
  <div slot='error'>
    <slot name='error'>
      <p class='af-lazy-error-text'>Couldn't load this content.</p>
    </slot>
  </div>
</Suspense>

<style>
  @layer base {
    .af-lazy-spinner-wrap {
      text-align: center;
      color: currentColor;
    }
    .af-lazy-spinner {
      display: inline-block;
      width: 2rem;
      height: 2rem;
      border: 2px solid color-mix(in oklab, currentColor 30%, transparent);
      border-top-color: currentColor;
      border-radius: 9999px;
      animation: af-lazy-spin 0.8s linear infinite;
    }
    .af-lazy-loading-text {
      margin-top: 1rem;
      font-size: 0.875rem;
    }
    .af-lazy-error-text {
      text-align: center;
      color: currentColor;
    }
    @keyframes af-lazy-spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .af-lazy-spinner {
        animation-duration: 0.01ms;
      }
    }
  }
</style>

---
/**
 * Checkbox group wrapped in a `<fieldset>`/`<legend>`. Generic/theme-token styled;
 * override via `class` / `legendClass` / `optionClass`.
 */
interface Props {
  /** Group label (rendered as the `<legend>`). */
  label: string;
  /** Shared checkbox `name`. */
  name: string;
  options: Array<{ value: string; label: string; id?: string }>;
  /** Hint linked to the fieldset via aria-describedby. */
  helpText?: string;
  class?: string;
  legendClass?: string;
  optionClass?: string;
  /** Classes on each checkbox `<input>` (for theming the control itself). */
  inputClass?: string;
  /** Classes on the help text. */
  helpClass?: string;
}

const {
  label,
  name,
  options,
  helpText,
  class: className = '',
  legendClass = '',
  optionClass = '',
  inputClass = '',
  helpClass = '',
} = Astro.props;

// Rich help: a `help` slot lets callers pass multiline / coloured markup that a
// single `helpText` string can't express. Either is linked via aria-describedby.
const hasHelpSlot = Astro.slots.has('help');
const helpId = helpText || hasHelpSlot ? `${name}-help` : undefined;
const optionId = (o: { value: string; id?: string }) => o.id ?? `${name}-${o.value}`;
---

<fieldset class:list={['af-group', className]} aria-describedby={helpId}>
  <legend class:list={['af-group-legend', legendClass]}>{label}</legend>

  {
    (helpText || hasHelpSlot) && (
      <div id={helpId} class:list={['af-group-help', helpClass]}>
        {hasHelpSlot ? <slot name='help' /> : helpText}
      </div>
    )
  }

  <div class='af-group-options'>
    {
      options.map((option) => (
        <div class:list={['af-group-option', optionClass]}>
          <input
            type='checkbox'
            id={optionId(option)}
            name={name}
            value={option.value}
            class:list={[inputClass]}
          />
          <label for={optionId(option)}>{option.label}</label>
        </div>
      ))
    }
  </div>
</fieldset>

<style>
@layer base {
  :where(.af-group) {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :where(.af-group-legend) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-light-text-body, #2f2a44);
  }

  :global(:where([data-theme='dark'])) :where(.af-group-legend) {
    color: var(--color-dark-text-body, #e0dfe6);
  }

  :where(.af-group-help) {
    font-size: 0.75rem;
    color: var(--color-light-text-subtle, #6b6580);
  }

  :global(:where([data-theme='dark'])) :where(.af-group-help) {
    color: var(--color-dark-text-subtle, #a5a1b8);
  }

  :where(.af-group-options) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :where(.af-group-option) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-light-text-body, #2f2a44);
  }

  :global(:where([data-theme='dark'])) :where(.af-group-option) {
    color: var(--color-dark-text-body, #e0dfe6);
  }
}
</style>

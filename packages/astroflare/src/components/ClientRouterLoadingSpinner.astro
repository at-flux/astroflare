---
/**
 * Loading spinner for Astro view transitions.
 * Uses native <dialog> shown during page transitions.
 * Override styles via CSS custom properties or by targeting #loading.
 *
 * The indicator itself is `LoadingSpinner`; fill the default slot to replace it.
 */
import LoadingSpinner from './LoadingSpinner.astro';

interface Props {
  /**
   * Accessible name for the dialog, and the text a screen reader announces when
   * it opens. A modal `<dialog>` with no name is announced as bare "dialog", so
   * this always has a value.
   */
  label?: string;
}

const { label = 'Loading' } = Astro.props;
---

<dialog
  id='loading'
  aria-label={label}
  class='backdrop:bg-black/60 bg-transparent p-0 w-full h-full max-w-none max-h-none'
>
  <div class='flex items-center justify-center min-h-full p-0'>
    <div class='loading-spinner' role='status' aria-live='polite'>
      <span class='af-visually-hidden'>{label}</span>
      <slot>
        <LoadingSpinner size='3rem' />
      </slot>
    </div>
  </div>
</dialog>

<style>
  /* Announced, never drawn: the dialog needs a name and the status region needs
     text, but the visible indicator is the spinner itself. */
  .af-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .loading-spinner {
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
  }

  #loading[open] .loading-spinner {
    opacity: 1;
    transform: scale(1);
  }

  #loading.fade-out .loading-spinner {
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-spinner { transition: none; }
  }
</style>

<script is:inline>
  // Guard: this inline script may be re-evaluated across ClientRouter swaps, but the
  // listeners live on the persistent `document`. Bind them once to avoid stacking.
  if (!window.__astroflareLoadingSpinnerBound__) {
    window.__astroflareLoadingSpinnerBound__ = true;

    document.addEventListener('astro:before-preparation', () => {
      const d = document.querySelector('#loading');
      if (d) d.showModal();
    });

    document.addEventListener('astro:page-load', () => {
      const d = document.querySelector('#loading');
      if (d) {
        d.classList.add('fade-out');
        setTimeout(() => {
          d.close();
          d.classList.remove('fade-out');
        }, 150);
      }
    });
  }
</script>

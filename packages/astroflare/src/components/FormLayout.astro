---
/**
 * Two-part form layout: a heading region (title + optional subtitle + `description`
 * slot) above the default slot of form content. Generic/theme-token styled.
 */
interface Props {
  title: string;
  subtitle?: string;
  /** When true, renders the `description` slot below the subtitle. */
  hasDescription?: boolean;
  class?: string;
}

const { title, subtitle, hasDescription = false, class: className = '' } = Astro.props;
---

<div class:list={['af-layout', className]}>
  <div class='af-layout-head'>
    <h2 class='af-layout-title'>{title}</h2>
    {subtitle && <p class='af-layout-subtitle'>{subtitle}</p>}
    {
      hasDescription && (
        <div class='af-layout-description'>
          <slot name='description' />
        </div>
      )
    }
  </div>

  <div class='af-layout-body'>
    <slot />
  </div>
</div>

<style>
  .af-layout {
    max-width: 56rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .af-layout-title {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--color-light-text-heading, #1c1830);
  }

  :global([data-theme='dark']) .af-layout-title {
    color: var(--color-dark-text-heading, #f4f2fb);
  }

  .af-layout-subtitle {
    font-size: 1.25rem;
    color: var(--color-light-text-subtle, #6b6580);
  }

  :global([data-theme='dark']) .af-layout-subtitle {
    color: var(--color-dark-text-subtle, #a5a1b8);
  }

  .af-layout-description {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>

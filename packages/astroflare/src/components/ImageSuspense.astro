---
/**
 * ImageSuspense — suspense wrapper for media that loads.
 *
 * A preset over {@link Suspense.astro}: the same gate → readiness → swap
 * machine, fixed to the media case. Wraps any slotted `<img>`, `<picture>`, or
 * Astro `<Image />` (which renders an `<img>`) and shows a spinner — or a
 * shimmer skeleton — until the image finishes loading, then fades the image in
 * and the placeholder out. Cached images resolve inside the grace window, so
 * the placeholder is never painted at all.
 *
 * Exported as `ImageSuspense`; `ImageFade` is a kept alias of the same
 * component.
 *
 * Lazy images work reliably even inside `server:defer` islands: a wrapper-level
 * IntersectionObserver drives the fetch, so images parsed from streamed island
 * HTML (whose native lazy state Chromium never arms) still load and reveal
 * instead of spinning forever.
 *
 * Reserve layout space with `aspectRatio` to avoid CLS. Styling is theme-aware
 * via `--color-brand` (override with `spinnerColor`).
 *
 * The wrapper only controls the slotted image's opacity — size the image and
 * choose its `object-fit` with your own classes, exactly as you would without
 * this wrapper.
 *
 * The default placeholder is a plain `LoadingSpinner` (or a shimmer skeleton).
 * Anything fancier belongs in the `placeholder` slot rather than in props —
 * whatever you put there is centred in the frame and faded out on load exactly
 * like the default.
 *
 * ### How it maps onto Suspense
 * | ImageSuspense    | Suspense                                       |
 * | ---------------- | ---------------------------------------------- |
 * | *(implicit)*     | `when="eager"`, `ready="auto"` (media readiness) |
 * | *(implicit)*     | `frame` — media always clips and tints          |
 * | `spinnerColor`   | `accent`                                        |
 * | `class`, `rounded`, `aspectRatio`, `duration`, `background`, `skeleton` | same names |
 * | `placeholder` slot | `placeholder` slot                            |
 *
 * Anything Suspense adds and this does not expose — `when="visible"`,
 * `minHeight`, `timeout`, `loadingLabel`, an `error` slot — is available by
 * using `Suspense` directly.
 *
 * The rendered host element is `<af-suspense>` (it was `<image-fade>` before
 * the unification); the legacy `image-fade` class is kept on it as a styling
 * hook.
 *
 * @example
 * <ImageSuspense aspectRatio="16/9" rounded="rounded-2xl">
 *   <Image src={hero} alt="…" />
 * </ImageSuspense>
 *
 * @example Custom indicator
 * <ImageSuspense aspectRatio="16/9">
 *   <LoadingSpinner slot="placeholder" dual size="3rem" color="var(--brand)" />
 *   <Image src={hero} alt="…" />
 * </ImageSuspense>
 */
import Suspense from './Suspense.astro';

interface Props {
  /** Extra classes merged onto the wrapper. */
  class?: string;
  /** Radius class/utility applied to the wrapper (clips the image), e.g. `rounded-2xl`. */
  rounded?: string;
  /** CSS `aspect-ratio` to reserve space and prevent layout shift, e.g. `"16/9"`, `"1"`. */
  aspectRatio?: string;
  /** Fade-in duration in ms. */
  duration?: number;
  /** Accent for the default spinner, the skeleton shimmer and the wrapper tint. */
  spinnerColor?: string;
  /** Wrapper background shown behind the image. Pass `"transparent"` for `object-contain` images. */
  background?: string;
  /** Show a shimmer skeleton instead of a spinner. */
  skeleton?: boolean;
}

const {
  class: className = '',
  rounded = '',
  aspectRatio,
  duration = 500,
  spinnerColor,
  background,
  skeleton = false,
} = Astro.props;
---

<Suspense
  class={`image-fade ${className}`.trim()}
  rounded={rounded}
  aspectRatio={aspectRatio}
  duration={duration}
  accent={spinnerColor}
  background={background}
  skeleton={skeleton}
  frame
>
  {Astro.slots.has('placeholder') && <slot name='placeholder' slot='placeholder' />}
  <slot />
</Suspense>

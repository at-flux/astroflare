---
/**
 * Headless modal using native `<dialog>`.
 * `class` applies to the modal panel (card). Dialog element keeps backdrop/transparent shell.
 */
interface Props {
  /** Dialog id used by triggers (`ModalTrigger`, direct DOM calls). */
  id: string;
  /** Panel (card) classes — surface, border, radius, etc. */
  class?: string;
  /** Classes applied to the `<dialog>` shell/backdrop container. */
  backdropClass?: string;
  /** Extra panel classes merged after `class`. */
  panelClass?: string;
  /** Classes applied to the built-in close button. */
  closeButtonClass?: string;
  /** Scrollable inner wrapper around the default slot. */
  contentClass?: string;
  /** Id of an element inside the modal that names it (→ `aria-labelledby`). */
  labelledBy?: string;
  /** Accessible name when no visible heading exists (→ `aria-label`). Ignored if `labelledBy` set. */
  label?: string;
}

const {
  id,
  class: className = '',
  backdropClass = 'backdrop:bg-black/80 bg-transparent p-0 w-full h-full max-w-none max-h-none overflow-hidden',
  panelClass = '',
  closeButtonClass = 'absolute top-3 right-6 z-50 flex h-10 w-10 items-center justify-center rounded-full opacity-80 transition-opacity hover:opacity-100',
  contentClass = 'relative overflow-y-auto max-h-[calc(100dvh-2rem)]',
  labelledBy,
  label,
} = Astro.props;
---

<app-modal>
  <dialog
    id={id}
    class:list={[backdropClass]}
    aria-labelledby={labelledBy}
    aria-label={labelledBy ? undefined : label}
  >
    <div class='flex min-h-full items-center justify-center p-0 md:p-4'>
      <div
        class:list={[
          'relative max-h-[100dvh] w-[100dvw] max-w-4xl overflow-hidden outline-none',
          className,
          panelClass,
        ]}
      >
        <button class:list={[closeButtonClass]} type='button' aria-label='Close modal'>
          <svg
            width='20'
            height='20'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d='M18 6L6 18'></path>
            <path d='M6 6L18 18'></path>
          </svg>
        </button>

        <div class:list={[contentClass]}>
          <slot />
        </div>
      </div>
    </div>
  </dialog>
</app-modal>

<script>
  // Body scroll-lock shared across every modal on the page. A native modal
  // `<dialog>` (opened via `showModal()`) renders in the top layer but does NOT
  // stop the page behind it from keeping its own scrollbar — so the viewport
  // shows two scrollbars while a modal is open. Locking `overflow: hidden` on
  // the root element removes the page scrollbar; a ref-count keeps nested/stacked
  // modals correct, and padding compensation avoids the layout shift that hiding
  // the scrollbar would otherwise cause.
  const LOCK_KEY = '__astroflareModalScrollLock__';
  interface LockWindow extends Window {
    [LOCK_KEY]?: number;
  }
  const lockWin = window as unknown as LockWindow;

  function lockScroll() {
    const count = lockWin[LOCK_KEY] ?? 0;
    if (count === 0) {
      const root = document.documentElement;
      const scrollbarWidth = window.innerWidth - root.clientWidth;
      root.style.overflow = 'hidden';
      if (scrollbarWidth > 0) root.style.paddingRight = `${scrollbarWidth}px`;
    }
    lockWin[LOCK_KEY] = count + 1;
  }

  function unlockScroll() {
    const count = lockWin[LOCK_KEY] ?? 0;
    if (count <= 1) {
      const root = document.documentElement;
      root.style.overflow = '';
      root.style.paddingRight = '';
      lockWin[LOCK_KEY] = 0;
      return;
    }
    lockWin[LOCK_KEY] = count - 1;
  }

  class AppModal extends HTMLElement {
    private observer: MutationObserver | null = null;
    private locked = false;

    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      if (!dialog) return;

      const closeBtn = this.querySelector<HTMLButtonElement>('button[aria-label="Close modal"]');
      closeBtn?.addEventListener('click', () => dialog.close());

      // `showModal()` / `close()` toggle the `open` attribute; mirror the lock to
      // it so the scroll-lock tracks the dialog no matter who opens or closes it
      // (trigger click, Esc, backdrop, programmatic).
      const sync = () => {
        if (dialog.open && !this.locked) {
          this.locked = true;
          lockScroll();
        } else if (!dialog.open && this.locked) {
          this.locked = false;
          unlockScroll();
        }
      };
      this.observer = new MutationObserver(sync);
      this.observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });
      sync();
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.observer = null;
      // Released here too so a ClientRouter navigation while a modal is open does
      // not leave the page permanently scroll-locked.
      if (this.locked) {
        this.locked = false;
        unlockScroll();
      }
    }
  }

  if (!customElements.get('app-modal')) {
    customElements.define('app-modal', AppModal);
  }
</script>

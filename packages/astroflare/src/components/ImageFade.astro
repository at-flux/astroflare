---
/**
 * ImageFade — kept alias for {@link ImageSuspense}.
 *
 * @deprecated Both this and `ImageSuspense` are removed in the next major. Use
 * `Suspense.astro` directly; see the note on `ImageSuspense` for the prop mapping.
 *
 * The component was renamed to `ImageSuspense` (it suspends any loading media
 * behind a spinner, not only fades). This thin passthrough keeps existing
 * `ImageFade` imports working; prefer importing `ImageSuspense` directly in new
 * code. Same props, same output — which since the Suspense unification is an
 * `<af-suspense class="image-fade …">` host, not an `<image-fade>` element.
 */
import ImageSuspense from './ImageSuspense.astro';
---

<ImageSuspense {...Astro.props}>
  {Astro.slots.has('placeholder') && <slot name='placeholder' slot='placeholder' />}
  <slot />
</ImageSuspense>

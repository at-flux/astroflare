---
import "../../src/styles/global.css";
import CollectionQuery from "../../../src/components/CollectionQuery.astro";
import DateRangeFilterControls from "../../../src/components/DateRangeFilterControls.astro";
import DisclosurePanel from "../../../src/components/DisclosurePanel.astro";
import LiveRegion from "../../../src/components/LiveRegion.astro";
import ServerCollectionQueryResults from "../components/ServerCollectionQueryResults.astro";
import GuideLayout from "../layouts/GuideLayout.astro";
import { nav } from "../nav";
import { matchesCollectionFilters, paginateCollection, parseCollectionQuery } from "../../../src/collection-query";
import { isLiveRegionRequest } from "../../../src/live-region";

const cards = [
  { title: "Alpha release notes", tags: ["ops", "platform"] },
  { title: "Beta product diary", tags: ["product"] },
  { title: "Gamma render trial", tags: ["platform", "ux"] },
  { title: "Delta launch prep", tags: ["ops"] },
  { title: "Epsilon editorial flow", tags: ["content", "ux"] },
];
/* The two demos share a URL, so the client one namespaces every param it owns
   (`clientPageSize`) and leaves `page`/`size`/`offset`/`filters` to the server
   one. */
const clientSizeOptions = [1, 2, 3, 4, 5, 10];
const clientSizeRaw = Number.parseInt(Astro.url.searchParams.get("clientPageSize") ?? "2", 10);
const clientSize = Number.isFinite(clientSizeRaw) ? Math.max(1, clientSizeRaw) : 2;
const serverRegionId = "server-query";
const serverSizeOptions = [1, 2, 3, 4, 5, 10];
const serverQuery = parseCollectionQuery(Astro.url.searchParams, { defaultSize: 1 });
const serverFilteredCards =
  Object.keys(serverQuery.filters).length === 0
    ? cards
    : cards.filter((card) => matchesCollectionFilters({ tag: card.tags }, serverQuery.filters));
const serverPageData = paginateCollection(serverFilteredCards, serverQuery);
const serverCurrentPage = Math.min(
  serverPageData.totalPages,
  Math.max(1, Math.floor(serverQuery.offset / serverQuery.size) + 1),
);
const serverActiveQuery = {
  ...serverQuery,
  page: serverCurrentPage,
  offset: (serverCurrentPage - 1) * serverQuery.size,
};
const serverFilterTags = Array.from(new Set(cards.flatMap((card) => card.tags))).sort((a, b) =>
  a.localeCompare(b),
);
/* Defer on a cold load so the controls paint first. A live-region swap already
   has its own fallback and swaps the markup itself, so serve it the real
   content rather than an island placeholder and save the second round trip. */
const shouldDeferResults = !isLiveRegionRequest(Astro.request, serverRegionId);
const demoStickyParams = { filters_open: "1" };
const demoBaseFilters = { tag: "platform" };
const demoDatePresets = [
  {
    value: "last_30_days",
    label: "Last 30 Days",
    href: "/paging?filters_open=1&filters=%7B%22tag%22%3A%22platform%22%2C%22date_from%22%3A%222026-03-01%22%2C%22date_to%22%3A%222026-03-31%22%7D",
  },
  {
    value: "year_to_date",
    label: "Year to Date",
    href: "/paging?filters_open=1&filters=%7B%22tag%22%3A%22platform%22%2C%22date_from%22%3A%222026-01-01%22%7D",
    active: true,
  },
];
---

<GuideLayout title="Astroflare Styleguide" nav={nav}>
  <section class="sg-card sg-grid">
    <h2>Client filtering and paging</h2>
    <p class="sg-muted">Entire dataset stays in the browser, including page-size controls.</p>
    <form method="get" class="sg-size-form">
      <label for="sg-client-size-select">Page size</label>
      <select id="sg-client-size-select" name="clientPageSize" onchange="this.form.submit()">
        {clientSizeOptions.map((size) => (
          <option value={String(size)} selected={clientSize === size}>{size}</option>
        ))}
      </select>
      {Astro.url.searchParams.get("size") && <input type="hidden" name="size" value={Astro.url.searchParams.get("size") ?? ""} />}
      {Astro.url.searchParams.get("page") && <input type="hidden" name="page" value={Astro.url.searchParams.get("page") ?? ""} />}
      {Astro.url.searchParams.get("offset") && <input type="hidden" name="offset" value={Astro.url.searchParams.get("offset") ?? ""} />}
      {Astro.url.searchParams.get("filters") && <input type="hidden" name="filters" value={Astro.url.searchParams.get("filters") ?? ""} />}
    </form>
    <CollectionQuery perPage={clientSize}>
      <div class="sg-grid">
        {cards.map((card) => (
          <article data-card data-tags={card.tags.join("|")} class="sg-card">
            <h3>{card.title}</h3>
            <p>{card.tags.join(" / ")}</p>
          </article>
        ))}
      </div>
    </CollectionQuery>
  </section>

  <section class="sg-card sg-grid">
    <h2>Server query paging</h2>
    <p class="sg-muted">
      State lives in the query string, but the controls never navigate: the region fetches the
      same URL, swaps its own markup in, and the scroll position never moves.
    </p>
    {/* `CollectionQuery` renders its own page-size selector in server mode, so
        this demo does not hand-roll a second one. It also needs `totalItems`:
        the count defaults to 0, and at 0 the selector renders permanently
        disabled behind an "Unavailable" tooltip.

        Controls and results sit inside one `LiveRegion`, so a page change swaps
        both together — the pager's active pill and the results always agree. */}
    <LiveRegion id={serverRegionId} announce="Loading results…">
      <CollectionQuery
        useServer
        pathname={Astro.url.pathname}
        query={serverActiveQuery}
        totalPages={serverPageData.totalPages}
        currentPage={serverCurrentPage}
        totalItems={serverFilteredCards.length}
        sizeOptions={serverSizeOptions}
        filters={serverFilterTags.map((tag) => ({ key: "tag", value: tag }))}
      />
      {shouldDeferResults ? (
        <ServerCollectionQueryResults search={Astro.url.search} server:defer>
          <div slot="fallback" class="sg-grid sg-server-results sg-server-fallback">
            <div class="sg-controls-skeleton" aria-hidden="true"></div>
            <div class="sg-grid sg-server-results">
              <article class="sg-card sg-skeleton-card" aria-hidden="true"></article>
            </div>
          </div>
        </ServerCollectionQueryResults>
      ) : (
        <ServerCollectionQueryResults search={Astro.url.search} />
      )}
      {/* The `fallback` slot is the configurable half of the suspense: swap it
          for a skeleton, or drop `suspense` for a silent swap. */}
      <p slot="fallback" class="sg-live-fallback">Fetching page…</p>
    </LiveRegion>
  </section>

  <section class="sg-card sg-grid">
    <h2>Disclosure and date controls</h2>
    <p class="sg-muted">Mirrors the filter accordion/date-range composition used in host apps.</p>
    <DisclosurePanel summary="Filters" open>
      <DateRangeFilterControls
        pathname="/paging"
        size={serverActiveQuery.size}
        activeDateFrom="2026-01-01"
        activeDateTo=""
        baseFilters={demoBaseFilters}
        anyDateHref="/paging?filters_open=1&filters=%7B%22tag%22%3A%22platform%22%7D"
        datePresets={demoDatePresets}
        stickyParams={demoStickyParams}
      />
    </DisclosurePanel>
  </section>
</GuideLayout>

---
import "../../src/styles/global.css";
import IconButton from "../../../src/components/IconButton.astro";
import ShareLinks from "../../../src/components/ShareLinks.astro";
import ThemeToggle from "../../../src/components/ThemeToggle.astro";
import ClientRouterLoadingSpinner from "../../../src/components/ClientRouterLoadingSpinner.astro";
import GuideLayout from "../layouts/GuideLayout.astro";
import { nav } from "../nav";
---

<GuideLayout title="Astroflare Styleguide" nav={nav}>
  <section class="sg-card sg-grid">
    <h2>Icon buttons</h2>
    <p class="sg-muted">Use these for compact control affordances.</p>
    <div class="sg-inline">
      <IconButton label="Settings"><span aria-hidden="true">⚙</span></IconButton>
      <IconButton label="Search"><span aria-hidden="true">⌕</span></IconButton>
    </div>
  </section>

  <section class="sg-card sg-grid">
    <h2>Share links</h2>
    <p class="sg-muted">
      Pass one entry per network; present entries render in the given order. <code>copy</code> is
      a ClientRouter-safe clipboard button; <code>instagram</code> needs an explicit href.
    </p>
    <ShareLinks
      heading="Share this"
      url="https://example.com/post/hello/"
      text="Hello World"
      links={[
        { network: "bluesky" },
        { network: "facebook" },
        { network: "x" },
        { network: "copy" },
      ]}
    />
  </section>

  <section class="sg-card sg-grid">
    <h2>Theme toggle</h2>
    <p class="sg-muted">Built-in light/dark switch component.</p>
    <ThemeToggle />
  </section>

  <section class="sg-card sg-grid">
    <h2>Route loading spinner</h2>
    <p class="sg-muted">Preview transition behaviour with a manual trigger.</p>
    {/* A show-only trigger used to live here. Nothing on this page ever fires
        `astro:page-load`, so the overlay it raised stayed up and blocked the
        whole page — the cycle below shows the same spinner and puts it away. */}
    <div class="sg-inline">
      <button type="button" class="sg-btn" id="sg-spinner-cycle">Show + hide</button>
    </div>
    <ClientRouterLoadingSpinner />
  </section>
</GuideLayout>

<script>
  const cycle = document.querySelector("#sg-spinner-cycle");
  cycle?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("astro:before-preparation"));
    window.setTimeout(() => {
      document.dispatchEvent(new CustomEvent("astro:page-load"));
    }, 700);
  });
</script>
